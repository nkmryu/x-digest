# X Developer Console のアプリの OAuth 2.0 Client ID
X_CLIENT_ID=
# アプリの種類を Web App（confidential client）にした場合だけ書く。Native App なら空のまま
X_CLIENT_SECRET=
# アプリの Callback URI と完全に同じ値にする
X_REDIRECT_URI=http://127.0.0.1:8765/callback

# Claude Console で作った API キー。`ant auth login` を使うときは、この行をコメントのままにする
# （空の ANTHROPIC_API_KEY= でも「設定あり」とみなされ、ログイン情報より優先される）
# ANTHROPIC_API_KEY=
# 既定は claude-opus-5-5
CLAUDE_MODEL=
