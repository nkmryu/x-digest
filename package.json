{
  "name": "x-digest",
  "private": true,
  "type": "module",
  "scripts": {
    "x:login": "node --env-file-if-exists=.env --import tsx src/commands/login.ts",
    "x:fetch": "node --env-file-if-exists=.env --import tsx src/commands/fetch.ts",
    "x:propose": "node --env-file-if-exists=.env --import tsx src/commands/propose.ts",
    "x:refs": "node --env-file-if-exists=.env --import tsx src/commands/refs.ts",
    "x:classify": "node --env-file-if-exists=.env --import tsx src/commands/classify.ts",
    "x:authors": "node --env-file-if-exists=.env --import tsx src/commands/authors.ts",
    "x:pick": "node --env-file-if-exists=.env --import tsx src/commands/pick.ts",
    "x:unbookmark": "node --env-file-if-exists=.env --import tsx src/commands/unbookmark.ts",
    "x:unlike": "node --env-file-if-exists=.env --import tsx src/commands/unlike.ts",
    "x:digest": "node --env-file-if-exists=.env --import tsx src/commands/digest.ts",
    "x:plan-html": "node --env-file-if-exists=.env --import tsx src/commands/plan-html.ts",
    "x:html": "node --env-file-if-exists=.env --import tsx src/commands/html.ts",
    "x:serve": "python3 -m http.server 4173 --bind 127.0.0.1 --directory out",
    "x:update": "pnpm x:fetch && pnpm x:classify && pnpm x:html",
    "x:sync": "pnpm x:fetch --full --prune && pnpm x:classify && pnpm x:authors && pnpm x:html",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
